# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# .env dosyası .gitignore içinde olduğundan repoya asla commit edilmez.

# --- Supabase ---
# Supabase Dashboard > Project Settings > API sayfasından alın.
# ÖNEMLİ: Burada SADECE anon (public) key kullanılır. service_role anahtarı
# hiçbir zaman istemci koduna veya bu dosyaya girilmez; Edge Function
# secret'ları Supabase Dashboard üzerinden ayrıca yönetilir.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Mapbox ---
# 1) Public token (istemci tarafında harita stilini çekmek için, "public"
#    scope'lu, client'ta bulunması güvenli): Mapbox Dashboard > Tokens.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) Downloads token (SADECE build makinesinde/EAS secret olarak kullanılır,
#    .env'e asla gerçek değerini yazıp commit etmeyin — yerel build için
#    kendi terminalinizde `export MAPBOX_DOWNLOADS_TOKEN=...` kullanın,
#    EAS Build için `eas secret:create` ile tanımlayın):
MAPBOX_DOWNLOADS_TOKEN=sk.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
